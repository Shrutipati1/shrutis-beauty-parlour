<%- include('partials/head') %>
<%- include('partials/header') %>
<main id="main">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Gallery</p>
      <h1>A look inside our <em>work</em></h1>
      <p class="lead">Sample imagery used for layout purposes. Replace these with your own photos from the admin dashboard.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="filter-tabs" data-filter-tabs>
        <button class="tab active" data-filter="all">All</button>
        <% galleryCategories.forEach(function (cat) { %>
          <button class="tab" data-filter="<%= cat %>"><%= cat %></button>
        <% }); %>
      </div>

      <div class="gallery-grid" id="galleryGrid">
        <% galleryItems.forEach(function (g, i) { %>
          <figure class="g-item reveal <%= i % 5 === 0 ? 'tall' : '' %>" data-category="<%= g.category %>">
            <button type="button" class="g-open" data-lightbox
                    data-full="<%= g.image_url %>"
                    data-caption="<%= (g.title || g.category) %>">
              <img src="<%= g.image_url %>" alt="<%= g.title || g.category %>" loading="lazy">
              <span class="g-zoom" aria-hidden="true">+</span>
            </button>
            <figcaption><%= g.title || g.category %> <small><%= g.category %></small></figcaption>
          </figure>
        <% }); %>
      </div>
      <p class="empty-note" data-empty hidden>No images in this category yet.</p>
    </div>
  </section>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lb-close" type="button" aria-label="Close">&times;</button>
    <img src="" alt="">
    <p class="lb-caption"></p>
  </div>
</main>
<%- include('partials/footer') %>