<%- include('partials/head') %>
<section class="admin-panel">
  <div class="panel-head"><h2>Add an FAQ</h2></div>
  <form class="admin-form" id="faqForm" method="post" action="/admin/faqs/save">
    <input type="hidden" name="id" value="">
    <div class="form-grid">
      <label class="field span-2"><span>Question *</span><input type="text" name="question" required></label>
      <label class="field span-2"><span>Answer *</span><textarea name="answer" rows="3" required></textarea></label>
      <label class="field"><span>Sort order</span><input type="number" name="sort_order" min="0" value="0"></label>
      <label class="field"><span>Active</span>
        <select name="active"><option value="1">Visible</option><option value="0">Hidden</option></select>
      </label>
    </div>
    <div class="btn-row">
      <button class="btn btn-primary" type="submit">Save FAQ</button>
      <button class="btn btn-ghost" type="button" id="faqReset">Clear form</button>
    </div>
  </form>
</section>

<section class="admin-panel">
  <div class="panel-head"><h2>FAQs (<%= faqs.length %>)</h2></div>
  <div class="table-wrap">
    <table class="admin-table">
      <thead><tr><th>Question</th><th>Answer</th><th>Status</th><th></th></tr></thead>
      <tbody>
        <% faqs.forEach(function (f) { %>
          <tr>
            <td><strong><%= f.question %></strong></td>
            <td><%= f.answer.slice(0, 90) %><%= f.answer.length > 90 ? '…' : '' %></td>
            <td><%= f.active ? 'Visible' : 'Hidden' %></td>
            <td class="row-actions">
              <button class="link" data-edit-faq="<%= f.id %>">Edit</button>
              <button class="link danger" data-delete-faq="<%= f.id %>">Delete</button>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</section>
<script type="application/json" id="faqsData"><%- JSON.stringify(faqs) %></script>
<%- include('partials/foot', { adminScript: '/js/admin-services.js' }) %>