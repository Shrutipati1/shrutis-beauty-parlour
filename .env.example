# ---- Server ----
PORT=3001
NODE_ENV=development

# Secret used to sign the session cookie. CHANGE THIS in production.
SESSION_SECRET=please-change-this-to-a-long-random-string

# ---- Admin login (used on first seed) ----
ADMIN_EMAIL=admin@shrutisbeautyparlour.local
ADMIN_PASSWORD=ChangeMe@123

# ---- Email (SMTP) - leave empty and emails will be logged to the DB instead ----
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@email.com
# SMTP_PASS=your-app-password
# MAIL_FROM="Shruti's Beauty Parlour" <no-reply@yourdomain.com>
SALON_OWNER_EMAIL=owner@yourdomain.com

# ---- SMS (optional, provider-agnostic webhook) ----
# Any endpoint that accepts { to, message } and returns 2xx on success.
# SMS_WEBHOOK_URL=https://api.your-sms-provider.com/send
# SMS_WEBHOOK_KEY=your-api-key

# ---- WhatsApp ----
# International format without + or spaces, e.g. 919876543210
WHATSAPP_NUMBER=919876543210

# ---- Salon defaults (editable later in admin) ----
SALON_NAME=Shruti's Beauty Parlour
SALON_TIMEZONE=Asia/Kolkata